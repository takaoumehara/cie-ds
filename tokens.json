{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "cie-ds",
  "source": "https://creativityiseverywhere.com (repo takaoumehara/creativityiseverywhere.com main)",
  "extracted": "2026-10-05",
  "color": {
    "ink": {
      "value": "#0b0b0b",
      "css": "--cie-ink"
    },
    "paper": {
      "value": "#f3f2ee",
      "css": "--cie-paper",
      "contrastOnInk": "17.57:1"
    },
    "inkMute": {
      "value": "#9c9c98",
      "css": "--cie-ink-mute",
      "contrastOnInk": "7.14:1"
    },
    "paperMute": {
      "value": "#66665f",
      "css": "--cie-paper-mute",
      "contrastOnPaper": "5.16:1"
    },
    "stroke": {
      "value": "rgba(243, 242, 238, 0.42)",
      "css": "--cie-stroke"
    },
    "btn": {
      "value": "rgba(128, 128, 128, 0.32)",
      "css": "--cie-btn"
    },
    "btnHover": {
      "value": "rgba(128, 128, 128, 0.50)",
      "css": "--cie-btn-hover"
    }
  },
  "font": {
    "sans": {
      "family": "Outfit",
      "weights": "100..900 variable",
      "load": "https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap",
      "css": "--cie-sans"
    },
    "mono": {
      "family": "DM Mono",
      "weights": [
        400
      ],
      "load": "https://fonts.googleapis.com/css2?family=DM+Mono:wght@400&display=swap",
      "css": "--cie-mono"
    },
    "sansJa": {
      "family": "Zen Kaku Gothic New",
      "weights": [
        300,
        400,
        500,
        700
      ],
      "fallbacks": [
        "Hiragino Sans",
        "Hiragino Kaku Gothic ProN",
        "Noto Sans JP",
        "Yu Gothic"
      ],
      "load": "https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@300;400;500;700&display=swap",
      "css": "--cie-sans-ja",
      "notes": "Use :lang(ja). Tracking 0. Leading body 1.8. palt on."
    }
  },
  "typeSize": {
    "mark": "clamp(40px, min(7.4vw, 13vh), 112px)",
    "title": "clamp(56px, 11vw, 168px)",
    "row": "clamp(26px, 3.2vw, 44px)",
    "cell": "clamp(17px, 2.1vw, 30px)",
    "say": "clamp(22px, 2.1vw, 28px)",
    "body": "16px",
    "mono": "12px"
  },
  "space": {
    "base": "4px",
    "scale": [
      4,
      8,
      12,
      16,
      20,
      24,
      28,
      40,
      64
    ],
    "edge": "clamp(16px, 2.2vw, 28px)",
    "cellPad": "clamp(10px, 1.1vw, 16px)",
    "measure": "62ch"
  },
  "radius": {
    "block": "clamp(12px, 1.7vmin, 24px)",
    "page": "clamp(22px, 3.2vmin, 44px)",
    "pill": "9999px"
  },
  "shadow": {
    "default": "none"
  },
  "motion": {
    "snap": "120ms",
    "fast": "180ms",
    "cell": "320ms",
    "move": "360ms",
    "rise": "400ms",
    "sheet": "300ms",
    "stagger": "24ms",
    "easeExpo": "cubic-bezier(0.76, 0, 0.18, 1)",
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "easeSnap": "cubic-bezier(0.34, 1.22, 0.64, 1)",
    "notes": "Snappy にゅるっと: expand/move 280–420ms. Subtle overshoot via easeSnap optional."
  },
  "rules": [
    "Two colours only: ink and paper. No accent, no grey surface fills.",
    "Hierarchy is size and weight motion, not colour.",
    "Radius only on blocks, page cards, and round panel buttons.",
    "No shadow, no gradient between hues on the board (registry may use alpha of one ink — see DESIGN.md › Registry).",
    "Honour prefers-reduced-motion at runtime, not only in CSS.",
    "Sound is per-section toggle, never a global site mute.",
    "UI sounds: Web Audio only — no external audio files.",
    "Scrollbar stays thin (≈5px), not chunky."
  ],
  "scroll": {
    "revealY": "22px",
    "revealX": "14px",
    "parallaxMax": "48px",
    "pressScale": 0.97,
    "hoverNudge": "3px",
    "scrollbarSize": "5px"
  },
  "modules": [
    "tokens.css",
    "base.css",
    "scrollbar.css",
    "motion.css",
    "scroll.css",
    "interactions.css",
    "interaction.js",
    "registry.json (shadcn registry, generated theme from this file)"
  ],
  "semantic": {
    "notes": "shadcn semantic aliases. Generated into registry (cie-theme) + lib/cie-motion.ts by scripts/sync-tokens.mjs. dark = ink ground (CIE default; add class=\"dark\" on <html>), light = paper ground. Values are hex/rgba or {color.*} refs.",
    "radius": "{radius.block}",
    "dark": {
      "background": "{color.ink}",
      "foreground": "{color.paper}",
      "card": "{color.paper}",
      "card-foreground": "{color.ink}",
      "popover": "{color.ink}",
      "popover-foreground": "{color.paper}",
      "primary": "{color.paper}",
      "primary-foreground": "{color.ink}",
      "secondary": "{color.btn}",
      "secondary-foreground": "{color.paper}",
      "muted": "rgba(243, 242, 238, 0.06)",
      "muted-foreground": "{color.inkMute}",
      "accent": "rgba(243, 242, 238, 0.10)",
      "accent-foreground": "{color.paper}",
      "destructive": "#e5484d",
      "border": "rgba(243, 242, 238, 0.16)",
      "input": "rgba(243, 242, 238, 0.24)",
      "ring": "{color.inkMute}",
      "stroke": "{color.stroke}",
      "sidebar": "{color.ink}",
      "sidebar-foreground": "{color.paper}",
      "sidebar-primary": "{color.paper}",
      "sidebar-primary-foreground": "{color.ink}",
      "sidebar-accent": "rgba(243, 242, 238, 0.10)",
      "sidebar-accent-foreground": "{color.paper}",
      "sidebar-border": "rgba(243, 242, 238, 0.16)",
      "sidebar-ring": "{color.inkMute}",
      "chart-1": "{color.paper}",
      "chart-2": "#c9c8c4",
      "chart-3": "{color.inkMute}",
      "chart-4": "#6f6f6b",
      "chart-5": "#46463f"
    },
    "light": {
      "background": "{color.paper}",
      "foreground": "{color.ink}",
      "card": "{color.ink}",
      "card-foreground": "{color.paper}",
      "popover": "{color.paper}",
      "popover-foreground": "{color.ink}",
      "primary": "{color.ink}",
      "primary-foreground": "{color.paper}",
      "secondary": "{color.btn}",
      "secondary-foreground": "{color.ink}",
      "muted": "rgba(11, 11, 11, 0.05)",
      "muted-foreground": "{color.paperMute}",
      "accent": "rgba(11, 11, 11, 0.08)",
      "accent-foreground": "{color.ink}",
      "destructive": "#c62f35",
      "border": "rgba(11, 11, 11, 0.14)",
      "input": "rgba(11, 11, 11, 0.22)",
      "ring": "{color.paperMute}",
      "stroke": "rgba(11, 11, 11, 0.42)",
      "sidebar": "{color.paper}",
      "sidebar-foreground": "{color.ink}",
      "sidebar-primary": "{color.ink}",
      "sidebar-primary-foreground": "{color.paper}",
      "sidebar-accent": "rgba(11, 11, 11, 0.08)",
      "sidebar-accent-foreground": "{color.ink}",
      "sidebar-border": "rgba(11, 11, 11, 0.14)",
      "sidebar-ring": "{color.paperMute}",
      "chart-1": "{color.ink}",
      "chart-2": "#3a3a36",
      "chart-3": "{color.paperMute}",
      "chart-4": "#8f8f88",
      "chart-5": "#b8b7b1"
    },
    "exceptions": [
      "destructive is the only non-ink/paper hue; use it for errors and destructive actions only.",
      "chart-* are grey steps between the two inks, for data only."
    ]
  }
}
